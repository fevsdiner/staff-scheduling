# Supabase (optional — for production DB instead of .data/ JSON files)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Session signing (change in production)
AUTH_SECRET=

# Google Sheets export (Step 7)
# Create a service account in Google Cloud, enable Sheets API, download JSON key.
# Share your spreadsheet with the service account email (Editor access).
# IMPORTANT: put real values in .env.local — Next.js does NOT read this example file.
GOOGLE_SHEETS_SPREADSHEET_ID=
# Paste the full service account JSON on one line, or use a minified JSON string.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Tab name to overwrite (default: Sheet1)
GOOGLE_SHEETS_TAB_NAME=Sheet1
